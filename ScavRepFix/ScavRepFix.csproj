<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>ScavRepFix</RootNamespace>
    <AssemblyName>ScavRepFix</AssemblyName>
    <Product>ScavRepFix for SPT</Product>
    <Description>Guards the SPT 4.1.0 scav-reputation kill patch against a known null-reference error.</Description>
    <Authors>Hysocs</Authors>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\..\..\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\..\..\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\..\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\..\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <InstallDir>$(MSBuildProjectDirectory)\..\..\..\BepInEx\plugins\Hysocs-ScavRepFix</InstallDir>
    <PackageRoot>$(MSBuildProjectDirectory)\dist\ScavRepFix-$(Version)</PackageRoot>
    <PackageZip>$(MSBuildProjectDirectory)\dist\ScavRepFix-$(Version).zip</PackageZip>
  </PropertyGroup>

  <Target Name="DeployClient"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(InstallDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(InstallDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CreateReleasePackage"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(Configuration)' == 'Release' and '$(SkipPackage)' != 'true'">
    <RemoveDir Directories="$(PackageRoot)" />
    <Delete Files="$(PackageZip)" />
    <MakeDir Directories="$(PackageRoot)\BepInEx\plugins\Hysocs-ScavRepFix" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(PackageRoot)\BepInEx\plugins\Hysocs-ScavRepFix" />
    <Copy SourceFiles="README.md"
          DestinationFolder="$(PackageRoot)\BepInEx\plugins\Hysocs-ScavRepFix" />
    <ZipDirectory SourceDirectory="$(PackageRoot)"
                  DestinationFile="$(PackageZip)"
                  Overwrite="true" />
  </Target>

</Project>
